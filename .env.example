# OAuth "Desktop app" client from Google Cloud Console → Google Auth Platform → Clients.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Written by `npx @adginr/google-ads-mcp auth`.
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) account used to reach client accounts. Optional; dashes allowed.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
