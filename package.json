{
	"name": "google-ads-rest-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "pnpm -r build",
		"codegen": "pnpm --filter @adginr/google-ads-rest codegen",
		"typecheck": "pnpm -r typecheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && oxlint --type-aware --deny-warnings",
		"format": "prettier --write .",
		"check:package": "pnpm -r check:package",
		"changeset": "changeset",
		"release": "pnpm build && changeset publish"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@types/node": "^24",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"prettier": "^3.10.1",
		"publint": "^0.3.25",
		"tsdown": "^0.23.7",
		"typescript": "~7.0.2",
		"vitest": "^5.0.5"
	}
}
