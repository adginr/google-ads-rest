{
	"name": "google-ads-rest-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "pnpm -r build",
		"codegen": "pnpm --filter @adginr/google-ads-rest codegen",
		"typecheck": "pnpm -r typecheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check:package": "pnpm -r check:package",
		"changeset": "changeset",
		"release": "pnpm build && changeset publish"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.6.0",
		"prettier": "^3.9.10",
		"publint": "^0.3.25",
		"tsdown": "^0.23.1",
		"typescript": "~7.0.2",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.5"
	}
}
